{
  "schemaVersion": 1,
  "id": "vortex_plus_addon",
  "version": "${version}",
  "name": "Vortex Plus Addon",
  "description": "Vortex+ add-on modules, Armor Organizer, Inventory Tweak and local session/network HUD features. Modules use the existing HUD category because the main client is not modified.",
  "authors": [
    "Vortex Plus"
  ],
  "license": "MIT",
  "environment": "client",
  "entrypoints": {
    "client": [
      "de.vortexplus.addon.VortexPlusAddon"
    ]
  },
  "depends": {
    "fabricloader": ">=0.18.1",
    "minecraft": "1.21.11",
    "java": ">=21",
    "fabric-api": "*",
    "vortexclient": ">=2.20.0"
  },
  "icon": "assets/vortexplus/icon.png",
  "mixins": [
    {
      "config": "vortexplus.client.mixins.json",
      "environment": "client"
    }
  ]
}
